# Copy this file to .env and fill in what you have. Everything works without any of it
# (embedded database + simulated M-Pesa + SMS printed to the console).

# ---------- App ----------
# Fan API and business API are separate servers. Put the business one on its own domain
# (e.g. business.yourdomain.co.ke) and, if you can, restrict it by IP / VPN.
PORT=4000
BUSINESS_PORT=4100
SERVICE=all                          # all | public | business  (what this process runs)
NODE_ENV=development                 # production => secure cookies
PUBLIC_URL=http://localhost:5173     # the fan app address (used in SMS links)
VITE_FAN_URL=http://localhost:5173   # read by the business app at build time, for event links

# ---------- Database: MongoDB ----------
# Create a free cluster at https://www.mongodb.com/atlas → Connect → Drivers, paste the string here.
# Leave empty to use the built-in local MongoDB (data in ~/.pasi/mongo).
MONGODB_URI=
SEED_DEMO=false                      # true = load demo events into an empty real database (once)

# ---------- M-Pesa (Safaricom Daraja) ----------
# 1. Sign up at https://developer.safaricom.co.ke → My Apps → create an app with "Lipa Na M-Pesa Sandbox".
# 2. Copy the app's Consumer Key and Consumer Secret below.
# 3. The shortcode + passkey below are Safaricom's PUBLIC sandbox test values — fine for testing.
# 4. Safaricom must reach your callback over HTTPS. Locally, run a tunnel
#    (e.g. `cloudflared tunnel --url http://localhost:4000`) and put that https URL in MPESA_CALLBACK_URL.
MPESA_MODE=simulate                  # simulate | sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # CustomerBuyGoodsOnline if you use a Till
MPESA_PARTY_B=                       # your Till number when using Buy Goods; else leave empty
MPESA_CALLBACK_URL=                  # e.g. https://abc123.trycloudflare.com
MPESA_CALLBACK_TOKEN=change-me-to-a-long-random-string

# ---------- SMS (login codes, ticket links, squad invites) ----------
# Africa's Talking: https://account.africastalking.com → use username "sandbox" for testing.
SMS_PROVIDER=console                 # console | africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ---------- Platform ----------
PLATFORM_FEE_PCT=4
HOLD_SECONDS=180                     # how long seats are held while a buyer enters their PIN
TICKET_SECRET=                       # signs ticket QR codes; auto-generated into data/ if empty

# ---------- Web push (auto-generated into data/vapid.json if empty) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
