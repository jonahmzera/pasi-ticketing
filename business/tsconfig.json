{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../shared/src/*"] }
  },
  "include": ["src", "../shared/src", "vite.config.ts"],
  "exclude": ["src/sw.ts"]
}
